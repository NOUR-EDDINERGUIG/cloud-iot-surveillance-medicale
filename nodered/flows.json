    {
        "id": "2635b83022033a5c",
        "type": "function",
        "z": "4f2c037ce77946ae",
        "name": "Détection anomalies",
        "func": "\nvar d = msg.payload;\n\n// Extraction patient_id depuis le topic si absent\nif (!d.patient_id && msg.topic) {\n    var parts = msg.topic.split(\"/\");\n    d.patient_id = parts[1] || \"unknown\";\n}\n\nvar alertes = [];\nvar status = \"Normal\";\n\n// === Vérifications des paramètres ===\nfunction addAlerte(param, valeur, niveau) {\n    alertes.push({ parametre: param, valeur: valeur, niveau: niveau });\n}\n\n// Heart Rate\nif (d.heart_rate < 50 || d.heart_rate > 120) {\n    status = \"Critique\";\n    addAlerte(\"heart_rate\", d.heart_rate, \"Critique\");\n} else if (d.heart_rate < 60 || d.heart_rate > 100) {\n    if (status !== \"Critique\") status = \"Attention\";\n    addAlerte(\"heart_rate\", d.heart_rate, \"Attention\");\n}\n\n// Température\nif (d.temperature < 36 || d.temperature > 38.5) {\n    status = \"Critique\";\n    addAlerte(\"temperature\", d.temperature, \"Critique\");\n} else if ((d.temperature < 36.5 || d.temperature > 37.5) && status !== \"Critique\") {\n    status = \"Attention\";\n    addAlerte(\"temperature\", d.temperature, \"Attention\");\n}\n\n// SpO2\nif (d.spo2 < 92) {\n    status = \"Critique\";\n    addAlerte(\"spo2\", d.spo2, \"Critique\");\n} else if (d.spo2 < 95 && status !== \"Critique\") {\n    status = \"Attention\";\n    addAlerte(\"spo2\", d.spo2, \"Attention\");\n}\n\n// Tension Artérielle (Systolique + Diastolique)\nif (d.systolique > 180 || d.systolique < 80 || d.diastolique > 110 || d.diastolique < 50) {\n    status = \"Critique\";\n    addAlerte(\"tension\", `${d.systolique}/${d.diastolique}`, \"Critique\");\n} else if ((d.systolique > 140 || d.systolique < 90 || d.diastolique > 90 || d.diastolique < 60) && status !== \"Critique\") {\n    status = \"Attention\";\n    addAlerte(\"tension\", `${d.systolique}/${d.diastolique}`, \"Attention\");\n}\n\n// Ajout des infos dans le payload\nd.status = status;\nd.alertes = alertes;   // on garde les détails\n\n// Sortie 1 : Données complètes (pour stockage + dashboard)\nvar msg1 = { payload: d };\n\n// Sortie 2 : Alerte uniquement (si nécessaire)\nvar msg2 = null;\nif (alertes.length > 0) {\n    msg2 = {\n        payload: {\n            patient_id: d.patient_id,\n            status: status,\n            alertes: alertes,\n            timestamp: new Date().toISOString(),\n            message: `${alertes.length} alerte(s) détectée(s) pour le patient ${d.patient_id}`\n        }\n    };\n}\n\nreturn [msg1, msg2];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 240,
        "wires": [
            [
                "d68ad40504f2dc59",
                "d76b8f21d5b14a51"
            ],
            []
        ]
    },
    {
        "id": "d76b8f21d5b14a51",
        "type": "function",
        "z": "4f2c037ce77946ae",
        "name": "Format alertes",
        "func": "\nvar d = msg.payload;\n\n// Pas d'alerte\nif (!d.alertes || d.alertes.length === 0) {\n    return null;\n}\n\nlet alertesClean = d.alertes;\n\nif (Array.isArray(alertesClean[0])) {\n    alertesClean = alertesClean[0];\n}\n\nmsg.payload = [\n    {\n        alert_level: d.status,\n        nb_alertes: alertesClean.length,\n        heart_rate_alert: alertesClean.some(a => a.parametre === \"heart_rate\") ? 1 : 0,\n        temperature_alert: alertesClean.some(a => a.parametre === \"temperature\") ? 1 : 0,\n        spo2_alert: alertesClean.some(a => a.parametre === \"spo2\") ? 1 : 0,\n        tension_alert: alertesClean.some(a => a.parametre === \"tension\") ? 1 : 0,\n        alert_details: JSON.stringify(alertesClean)\n    },\n    {\n        patient_id: d.patient_id || \"unknown\",\n        status: d.status\n    }\n];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
