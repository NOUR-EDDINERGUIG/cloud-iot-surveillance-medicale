    {
        "id": "d68ad40504f2dc59",
        "type": "function",
        "z": "4f2c037ce77946ae",
        "name": "function 1",
        "func": "\nvar d = msg.payload;\n\nmsg.payload = [\n    {\n        heart_rate: Number(d.heart_rate),\n        temperature: Number(d.temperature),\n        spo2: Number(d.spo2),\n        systolique: Number(d.systolique),\n        diastolique: Number(d.diastolique),\n        status: d.status\n    },\n    {\n        patient_id: d.patient_id\n    }\n];\n\nreturn msg;\n",
